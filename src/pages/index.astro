---
import Resume from "../layouts/Resume.astro";
import english from "../content/en";
import { locales } from "../utils/locales.js";
import { basePath } from "../utils/paths.js";
const spanishPath = `${basePath(import.meta.env.BASE_URL)}${locales.es.path}`;
---
<Resume resume={english}>
  <!-- Compatibility for previously shared ?lang=es links. -->
  <script slot="head" is:inline define:vars={{ spanishPath }}>
    if (new URLSearchParams(location.search).get("lang") === "es") {
      const url = new URL(location.href);
      url.pathname = spanishPath;
      url.searchParams.delete("lang");
      location.replace(url);
    }
  </script>
</Resume>

---
import EntryHeader from "./EntryHeader.astro";
import EntryDetails from "./EntryDetails.astro";
import EntryFrame from "./EntryFrame.astro";
import ProjectList from "./ProjectList.astro";

const {
  leftEs,
  rightEs,
  leftEn,
  rightEn,
  subtitleEs,
  subtitleEn,
  bodyEs,
  bodyEn,
  href,
  projects,
  bullets,
} = Astro.props;
---
<EntryFrame href={projects ? undefined : href} isProjectEntry={Boolean(projects)}>
  <EntryHeader
    leftEs={leftEs}
    rightEs={rightEs}
    leftEn={leftEn}
    rightEn={rightEn}
  />
  {projects ? (
    <ProjectList projects={projects} />
  ) : (
    <EntryDetails
      subtitleEs={subtitleEs}
      subtitleEn={subtitleEn}
      bodyEs={bodyEs}
      bodyEn={bodyEn}
      bullets={bullets}
    />
  )}
</EntryFrame>

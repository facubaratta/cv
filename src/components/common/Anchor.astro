---
interface Props {
  href: string;
  class?: string;
}
const { href, class: className } = Astro.props;
const isExternal = /^https?:\/\//i.test(href);
---
<a
  class:list={["anchor", className]}
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
><slot /></a>

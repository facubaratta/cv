---
import BilingualText from "./BilingualText.astro";
import BulletList from "./BulletList.astro";

const { subtitleEs, subtitleEn, bodyEs, bodyEn, bullets } = Astro.props;
---
<BilingualText class="subtitle" es={subtitleEs} en={subtitleEn} />
{bullets ? (
  <BulletList bullets={bullets} />
) : (
  <>
    <br />
    <BilingualText es={bodyEs} en={bodyEn} />
  </>
)}

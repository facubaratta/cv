---
import Anchor from "./common/Anchor.astro";
import { profile } from "../content/profile.js";
import { linkedinUrl } from "../utils/profile.js";
const linkedinUsername = profile.linkedinUsername.split("/").filter(Boolean).at(-1);
---
<header>
  <h1><Anchor href={linkedinUrl}>{profile.name.toUpperCase()}</Anchor></h1>
  <p class="contact">
    <Anchor href={`mailto:${profile.email}`}>{profile.email}</Anchor>
    <span class="contact-separator" aria-hidden="true">|</span>
    <Anchor href={profile.whatsAppLink}>{profile.phone}</Anchor>
    <span class="contact-separator" aria-hidden="true">|</span>
    <Anchor href={linkedinUrl}>in/{linkedinUsername}</Anchor>
  </p>
</header>

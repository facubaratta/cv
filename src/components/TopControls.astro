---
const pdfBaseName = "Facundo_Baratta_CV";
const pdfFileName = `${pdfBaseName}_EN.pdf`;
const pdfBaseUrl = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---
<div class="top-controls" data-pdf-base-name={pdfBaseName} data-pdf-base-url={pdfBaseUrl}>
  <p class="interactive-note">
    <span aria-hidden="true">🔗 </span>
    <span class="lang-en">Entries are links</span>
    <span class="lang-es">Las entradas son enlaces</span>
  </p>
  <div class="top-controls-actions">
    <a class="pdf-btn" aria-label="Download PDF" href={`${pdfBaseUrl}${pdfFileName}`} download={pdfFileName}>Download PDF</a>
    <button class="lang-toggle" type="button" aria-label="Cambiar idioma a español">Español</button>
  </div>
</div>

<script>
  const controls = document.querySelector<HTMLElement>(".top-controls");
  const downloadLink = controls?.querySelector<HTMLAnchorElement>(".pdf-btn");
  const languageToggle = controls?.querySelector<HTMLButtonElement>(".lang-toggle");

  function setLanguage(language: "en" | "es") {
    document.documentElement.lang = language;
    if (!controls || !downloadLink || !languageToggle) return;

    const isSpanish = language === "es";
    const fileName = `${controls.dataset.pdfBaseName}_${language.toUpperCase()}.pdf`;
    const downloadLabel = isSpanish ? "Descargar PDF" : "Download PDF";
    downloadLink.href = `${controls.dataset.pdfBaseUrl}${fileName}`;
    downloadLink.download = fileName;
    downloadLink.textContent = downloadLabel;
    downloadLink.setAttribute("aria-label", downloadLabel);
    languageToggle.textContent = isSpanish ? "English" : "Español";
    languageToggle.setAttribute("aria-label", isSpanish ? "Switch language to English" : "Cambiar idioma a español");
  }

  setLanguage(new URLSearchParams(window.location.search).get("lang") === "es" ? "es" : "en");
  languageToggle?.addEventListener("click", () => {
    setLanguage(document.documentElement.lang === "es" ? "en" : "es");
  });
</script>

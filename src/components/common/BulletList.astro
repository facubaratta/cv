---
import type { Bullet } from "../../types/resume";
interface Props { bullets: Bullet[] }
const { bullets } = Astro.props;
---
<ul class="experience-bullets">
  {bullets.map((bullet) => (
    <li>
      {bullet.label && <strong>{bullet.label}: </strong>}
      {bullet.text}
      {bullet.children?.length && <Astro.self bullets={bullet.children} />}
    </li>
  ))}
</ul>

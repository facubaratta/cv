---
import type { Resume } from "../types/resume";
import { profile } from "../content/profile.js";
import { locales } from "../utils/locales.js";
import { basePath } from "../utils/paths.js";
import Header from "../components/Header.astro";
import TopControls from "../components/TopControls.astro";
import EntriesSection from "../components/sections/EntriesSection.astro";
import SkillsSection from "../components/sections/SkillsSection.astro";
import LanguagesSection from "../components/sections/LanguagesSection.astro";
import "../styles.css";
interface Props { resume: Resume }
const { resume } = Astro.props;
const base = basePath(import.meta.env.BASE_URL);
---
<!doctype html>
<html lang={resume.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={resume.description} />
    <title>CV - {profile.name}</title>
    {Object.entries(locales).map(([locale, info]) => <link rel="alternate" hreflang={locale} href={`${base}${info.path}`} />)}
    <slot name="head" />
  </head>
  <body>
    <main class="page">
      <TopControls resume={resume} />
      <div class="cv-content">
        <Header />
        <EntriesSection section={resume.education} locale={resume.locale} />
        <SkillsSection section={resume.skills} />
        <EntriesSection section={resume.experience} locale={resume.locale} />
        <LanguagesSection section={resume.languages} />
      </div>
    </main>
  </body>
</html>

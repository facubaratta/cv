---
const {
  leftEs,
  rightEs,
  leftEn,
  rightEn,
} = Astro.props;
---
<span class="entry-header lang-es">
  <span class="left">{leftEs}</span>
  <span class="right">{rightEs}</span>
</span>
<span class="entry-header lang-en">
  <span class="left">{leftEn}</span>
  <span class="right">{rightEn}</span>
</span>

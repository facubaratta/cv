---
import type { Entry, Locale } from "../../types/resume";
import { formatPeriod } from "../../utils/dates";
import Anchor from "./Anchor.astro";
import BulletList from "./BulletList.astro";
import ProjectList from "./ProjectList.astro";
import CourseList from "./CourseList.astro";
interface Props { entry: Entry; locale: Locale }
const { entry, locale } = Astro.props;
const Wrapper = entry.href && !entry.projects && !entry.courses ? Anchor : "div";
---
<div class="entry">
  <Wrapper href={entry.href!} class={Wrapper === "div" ? "entry-content" : undefined}>
    <span class="entry-header">
      <span class="entry-title">{entry.title}</span>
      <span class="entry-period">{formatPeriod(entry.period, locale)}</span>
    </span>
    {entry.organization && <span class="subtitle">{entry.organization}</span>}
    {entry.courses ? (
      <CourseList courses={entry.courses} />
    ) : entry.projects ? (
      <ProjectList projects={entry.projects} />
    ) : entry.bullets ? (
      <BulletList bullets={entry.bullets} />
    ) : entry.description && (
      <><br />{entry.description}</>
    )}
  </Wrapper>
</div>
